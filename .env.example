# Copy to .env.local for local development. In production set these in Coolify.

# Destination for the "Already a client? Sign in" button on /client-login.
# Read at request time, so changing it only needs a container restart, no rebuild.
# Must be an absolute http:// or https:// URL.
CLIENT_PORTAL_URL=http://eauwp2pl11szzlimj7q7gu91.169.58.169.162.sslip.io/

# Canonical site origin used for metadata, sitemap.xml and robots.txt.
# This one IS baked in at build time, so it must be set as a build argument.
NEXT_PUBLIC_SITE_URL=https://seefabs.com

# Google Search Console verification token (the content="..." value).
# Build-time, like NEXT_PUBLIC_SITE_URL, so pass it as a build argument.
GOOGLE_SITE_VERIFICATION=
